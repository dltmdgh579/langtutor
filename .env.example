# 음성 제공자: gemini (개발용, 무료 티어) | grok (Grok Voice 3.0)
VOICE_PROVIDER=gemini

# ---- Gemini (VOICE_PROVIDER=gemini) ----
# Google AI Studio(https://aistudio.google.com/apikey)에서 발급
GEMINI_API_KEY=
# Live API 실시간 음성 모델. 키로 쓸 수 있는 모델은 `npm run gemini:models`로 확인
GEMINI_VOICE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# 통화 후 피드백용 텍스트 모델
GEMINI_TEXT_MODEL=gemini-flash-latest

# ---- Grok (VOICE_PROVIDER=grok) ----
# xAI 콘솔(https://console.x.ai)에서 발급
XAI_API_KEY=
# grok-voice-latest는 현재 Grok Voice 3.0을 가리킵니다. 고정하려면 grok-voice-3.0
XAI_VOICE_MODEL=grok-voice-latest
XAI_TEXT_MODEL=grok-4-1-fast-non-reasoning

# 한 통화 최대 길이(분). 비용 폭주 방지용. 개발 중엔 3 정도로 줄여두세요.
MAX_CALL_MINUTES=15

PORT=3000
