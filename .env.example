# 음성 제공자: gemini (개발용, 무료 티어) | grok (Grok Voice 3.0)
VOICE_PROVIDER=gemini

# ---- Gemini (VOICE_PROVIDER=gemini) ----
# Google AI Studio(https://aistudio.google.com/apikey)에서 발급
GEMINI_API_KEY=
# Live API 실시간 음성 모델. 키로 쓸 수 있는 모델은 `npm run gemini:models`로 확인
GEMINI_VOICE_MODEL=gemini-3.8-live
# 통화 후 리포트용. 무료 티어에서는 Lite가 가장 안정적(약 15~20초)
GEMINI_TEXT_MODEL=gemini-flash-lite-latest
# 위 모델이 혼잡(503)하거나 응답이 없을 때 대신 쓰는 모델
GEMINI_TEXT_FALLBACK_MODEL=gemini-flash-latest

# ---- Grok (VOICE_PROVIDER=grok) ----
# xAI 콘솔(https://console.x.ai)에서 발급
XAI_API_KEY=
# grok-voice-latest는 현재 Grok Voice 3.0을 가리킵니다. 고정하려면 grok-voice-3.0
XAI_VOICE_MODEL=grok-voice-latest
XAI_TEXT_MODEL=grok-4-1-fast-non-reasoning

# 한 통화 최대 길이(분). 비용 폭주 방지용. 개발 중엔 3 정도로 줄여두세요.
MAX_CALL_MINUTES=15

PORT=3000

# ---- 로그인 · 사용 시간 (배포 시 필수) ----
# 둘 다 비워두면 로그인 없이 누구나 무제한으로 씁니다(로컬 개발용). 둘 중 하나만 넣으면 서버가 시작되지 않아요.
# Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)
GOOGLE_CLIENT_ID=
# Postgres 연결 문자열. 예) Neon: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL=
# 처음 가입한 계정에 주는 무료 통화 시간(분). 0이면 직접 지급한 사람만 통화할 수 있어요(npm run grant).
FREE_TRIAL_MINUTES=10

# ---- 결제 (Paddle) ----
# 셋 다 비워두면 충전 버튼이 없어요. 쓰려면 위의 로그인·DB도 설정해야 해요.
# sandbox(테스트) | production(실결제). 키·가격 ID는 환경마다 따로 발급돼요.
PADDLE_ENV=sandbox
# Developer tools → Authentication → Client-side tokens (test_… / live_…)
PADDLE_CLIENT_TOKEN=
# Developer tools → Notifications → 웹훅 대상의 Secret key (pdl_ntfset_…)
PADDLE_WEBHOOK_SECRET=
# 충전 상품: Paddle 가격 ID:지급할 분, 쉼표로 구분. 예) pri_01abc:60,pri_01def:300
PADDLE_PRICES=
