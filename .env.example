# xAI 콘솔(https://console.x.ai)에서 발급한 API 키
XAI_API_KEY=xai-...

# 실시간 음성 모델. grok-voice-latest는 현재 Grok Voice 3.0을 가리킵니다.
# 버전을 고정하려면 grok-voice-3.0 으로 바꾸세요.
XAI_VOICE_MODEL=grok-voice-latest

# 통화 후 피드백 생성에 쓰는 텍스트 모델
XAI_TEXT_MODEL=grok-4-1-fast-non-reasoning

# 한 통화 최대 길이(분). 비용 폭주 방지용.
MAX_CALL_MINUTES=15

PORT=3000
